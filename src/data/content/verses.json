[
  {
    "id": "verse_1",
    "iast": "namaśśāradāyai",
    "translation": "Salutations to Goddess Sharada."
  },
  {
    "id": "verse_2",
    "iast": "tvāmahaṃ prārthaye nityaṃ",
    "translation": "I pray to you daily."
  },
  {
    "id": "verse_3",
    "iast": "vidyāṃ buddhiṃ ca dehi me",
    "translation": "Give me knowledge and wisdom."
  }
]
